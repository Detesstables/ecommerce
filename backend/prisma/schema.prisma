generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENTE
}

model Usuario {
  id               Int    @id @default(autoincrement())
  nombre           String
  email            String @unique
  contraseña_hash String
  rol              Role   @default(CLIENTE)
  numero           String

  // --- ¡CAMPOS DE DIRECCIÓN ACTUALIZADOS! ---
  direccion_detalle String
  region_id         Int
  region            Region @relation(fields: [region_id], references: [id])

  fecha_creacion DateTime @default(now())

  pedidos                Pedido[]
  pedidos_personalizados PedidoPersonalizado[]
}

// --- PRODUCTOS ---
model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  imagenUrl   String?
  productos   Producto[]
  descripcion String?
}

model Producto {
  id                  Int      @id @default(autoincrement())
  nombre              String
  descripcion         String
  precio              Int
  stock               Int
  fecha_creacion      DateTime @default(now())
  fecha_actualizacion DateTime @updatedAt
  imagenUrl           String?

  items                  ItemPedido[]
  categoria_id           Int
  categoria              Categoria             @relation(fields: [categoria_id], references: [id])
  pedidos_personalizados PedidoPersonalizado[]
}

// --- PEDIDOS ---
enum EstadoPedido {
  PENDIENTE // Pago no confirmado (para el flujo Transbank)
  PAGO_APROBADO // Pago confirmado (para pedidos normales)
  EN_PREPARACION // El pedido está siendo empacado
  ENVIADO // El pedido salió a reparto
  ENTREGADO // El pedido fue recibido (reemplaza 'COMPLETADO')
  RECHAZADO // Pedido rechazado/cancelado
  COTIZADO
  CANCELADO
  CONVERTIDO_A_VENTA
}

model Pedido {
  id           Int          @id @default(autoincrement())
  fecha_pedido DateTime     @default(now())
  estado       EstadoPedido @default(PAGO_APROBADO)
  usuario_id   Int
  usuario      Usuario      @relation(fields: [usuario_id], references: [id])

  items ItemPedido[]
}

model ItemPedido {
  id                         Int      @id @default(autoincrement())
  cantidad                   Int
  precio_unitario_al_comprar Int
  pedido_id                  Int
  pedido                     Pedido   @relation(fields: [pedido_id], references: [id])
  producto_id                Int
  producto                   Producto @relation(fields: [producto_id], references: [id])

  @@unique([pedido_id, producto_id])
}

model Region {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique // Ej. "Región Metropolitana", "Valparaíso", etc.
  usuarios Usuario[] // Un usuario pertenece a una región (FK en Usuario)
}

// Enum para el estado de los pedidos personalizados
/**
 * enum EstadoPersonalizado {
 * PENDIENTE
 * REVISION
 * APROBADO
 * RECHAZADO
 * COMPLETADO
 * }
 */
model PedidoPersonalizado {
  id         Int     @id @default(autoincrement())
  usuario_id Int
  usuario    Usuario @relation(fields: [usuario_id], references: [id])

  titulo               String // Breve resumen de la solicitud
  descripcion_cliente  String // La descripción detallada
  referencia_img_url   String? // Imagen de referencia (opcional)
  presupuesto_estimado Int?
  presupuesto_final    Int?
  observacion_admin    String?
  // --- ¡AQUÍ ESTÁ LA CORRECCIÓN! ---
  estado               EstadoPedido @default(PENDIENTE)
  producto_id          Int?
  producto             Producto?    @relation(fields: [producto_id], references: [id])

  fecha_creacion DateTime @default(now())
}
